# Copier en .env.local et remplir. Ne jamais versionner les vraies valeurs.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : uniquement côté serveur (routes /api), jamais préfixée NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Google Agenda (compte de service partagé sur l'agenda du club)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
